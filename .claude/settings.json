{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-leakscan",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-activity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-question-relay",
            "timeout": 3600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-skill",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "set-hook-waveboard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "set-hook-wait-detect",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
